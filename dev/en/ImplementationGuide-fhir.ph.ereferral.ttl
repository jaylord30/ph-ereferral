       ] ;
       fhir:name [ fhir:v "ERefEncounter" ] ;
       fhir:description [ fhir:v "Encounter profile for the Philippine eReferral system. Extends PHCoreEncounter to capture the clinical encounter context associated with a referral, including encounter status, classification, participants, and clinical information relevant to the referral workflow." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
