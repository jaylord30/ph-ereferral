       ] ;
       fhir:name [ fhir:v "EReferral MedicationAdministration" ] ;
       fhir:description [ fhir:v "Profile for medications administered to patients in the Philippine eReferral context. Captures medications given as part of treatment (REF-39) and referenced via ServiceRequest.supportingInfo (REF-15) to provide clinical context for referrals." ] ;
