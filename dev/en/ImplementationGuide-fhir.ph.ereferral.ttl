       ] ;
       fhir:name [ fhir:v "EReferral Observation" ] ;
       fhir:description [ fhir:v "Profile for clinical observations in the Philippine eReferral context. \nSupports vital signs, laboratory results, and clinical measurements included in \nreferral clinical summaries. Referenced via ServiceRequest.supportingInfo and \nServiceRequest.reasonReference." ] ;
